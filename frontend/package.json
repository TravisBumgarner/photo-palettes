{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mv-html-to-ejs": "mv dist/index.html dist/index.ejs",
    "build": "tsc -b && vite build --mode production  && mv dist/ dist-web/ && npm run mv-html-to-ejs",
    "build:development": "tsc -b && vite build --mode development && mv dist/ dist-web/ && npm run mv-html-to-ejs",
    "ios:build": "tsc -b && vite build --mode production && mv dist/ dist-native/ && npx cap copy && npx cap sync && npx cap open ios",
    "ios:sync": "npx cap sync ios",
    "ios:dev-production": "NODE_ENV=production npm run ios:build && npx cap run ios",
    "ios:dev-development": "NODE_ENV=development npm run ios:build && npx cap run ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "start": "node index.js",
    "generate-mobile-assets": "npx capacitor-assets generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "install-docker-deps": "docker compose exec frontend npm i"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 80
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.1",
    "@preact/signals-react": "^3.3.0",
    "@sentry/node": "^10.5.0",
    "@sentry/react": "^10.5.0",
    "@supabase/supabase-js": "^2.55.0",
    "@tanstack/react-query": "^5.85.5",
    "@use-gesture/react": "^10.3.1",
    "blurhash": "^2.0.5",
    "color": "^5.0.0",
    "dexie": "^4.2.0",
    "ejs": "^3.1.9",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lodash.merge": "^4.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "react-share": "^5.2.2",
    "skmeans": "^0.11.3",
    "uuid": "^11.1.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.33.0",
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/addon-onboarding": "^9.1.3",
    "@storybook/addon-vitest": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@swc/core": "^1.13.4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/skmeans": "^0.11.8",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.3",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "storybook": "^9.1.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.46.3"
  },
  "engines": {
    "node": "22.18.x"
  }
}
